{
  "name": "ep-modpack",
  "version": "2.1.3",
  "description": "EP Modpack",
  "type": "module",
  "main": "src/main.js",
  "author": "Kurasava",
  "email": "flashbladepoint@mail.ru",
  "license": "ARR",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --publish never",
    "lint": "eslint"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  },
  "build": {
    "appId": "ru.kurasava.modpack",
    "productName": "EP Modpack",
    "artifactName": "EP.Modpack-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/electron"
    ],
    "linux": {
      "target": "AppImage",
      "icon": "src/assets/img/icons"
    },
    "win": {
      "target": "portable",
      "icon": "src/assets/img/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "src/assets/img/mac.icns",
      "identity": "-"
    }
  },
  "dependencies": {
    "prismarine-nbt": "^2.8.0"
  }
}
